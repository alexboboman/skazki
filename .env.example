ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: model for the safety check (defaults to ANTHROPIC_MODEL)
SAFETY_MODEL=
PORT=3000
# Images: openai (needs OPENAI_API_KEY) or mock (offline placeholders). Default: openai if key is set, else mock.
IMAGE_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_IMAGE_MODEL=gpt-image-1

# Database: leave empty for the embedded local PGlite, set a Postgres URL (e.g. Neon) in production.
DATABASE_URL=
# Auth: JWT_SECRET is required in production. AUTH_DEV_LOGIN=1 enables POST /v1/auth/dev (never in production).
JWT_SECRET=change-me
AUTH_DEV_LOGIN=1
APPLE_BUNDLE_ID=com.example.skazochnik
